---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
      aria-describedby="url-error"
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p id="url-error" class="feedback error" aria-live="polite"></p>
<p id="app-status" class="feedback" role="status" aria-live="polite"></p>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  import {
    BOOKMARK_SEPARATOR,
    BOOKMARKS_STORAGE_KEY,
    createUniqueSlug,
    formatBookmark,
    normalizeUrl,
    parseStoredBookmarks,
  } from '../lib/bookmarks.js';

  const form = document.querySelector('#add-bookmark');
  const input = document.querySelector('#url');
  const list = document.querySelector('#bookmark-list');
  const emptyState = document.querySelector('#empty-state');
  const listHeader = document.querySelector('#list-header');
  const urlError = document.querySelector('#url-error');
  const appStatus = document.querySelector('#app-status');
  const clearButton = document.querySelector('#clear-all');
  let bookmarks = [];

  function showError(message) {
    urlError.textContent = message;
    input.setAttribute('aria-invalid', message ? 'true' : 'false');
  }

  function showStatus(message, isError = false) {
    appStatus.textContent = message;
    appStatus.classList.toggle('error', isError);
  }

  function renderBookmarks() {
    list.replaceChildren();
    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.textContent = BOOKMARK_SEPARATOR;

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;
      slug.setAttribute('aria-label', `Short link: ${formatBookmark(bookmark)}`);

      const copyButton = document.createElement('button');
      copyButton.type = 'button';
      copyButton.className = 'copy';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          showStatus(`Copied ${bookmark.slug} to the clipboard.`);
        } catch {
          showStatus('Could not access the clipboard. Select and copy the slug instead.', true);
        }
      });

      item.append(link, separator, slug, copyButton);
      list.append(item);
    }

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  function persist(nextBookmarks) {
    try {
      localStorage.setItem(BOOKMARKS_STORAGE_KEY, JSON.stringify(nextBookmarks));
      showStatus('');
      return true;
    } catch {
      showStatus('Browser storage is unavailable. This change will not be saved after you leave.', true);
      return false;
    }
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    showError('');
    showStatus('');

    let url;
    try {
      url = normalizeUrl(input.value);
    } catch {
      showError('Enter a valid HTTP(S) URL, such as example.com or https://example.com.');
      input.focus();
      return;
    }

    const bookmark = {
      url,
      slug: createUniqueSlug(bookmarks.map(({ slug }) => slug)),
    };
    const nextBookmarks = [...bookmarks, bookmark];
    persist(nextBookmarks);
    bookmarks = nextBookmarks;
    renderBookmarks();
    input.value = '';
    input.focus();
  });

  input.addEventListener('input', () => {
    if (urlError.textContent) showError('');
  });

  clearButton.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;
    try {
      localStorage.removeItem(BOOKMARKS_STORAGE_KEY);
      bookmarks = [];
      renderBookmarks();
      showStatus('All bookmarks cleared.');
    } catch {
      showStatus('Could not clear browser storage. Your bookmarks were kept.', true);
    }
  });

  try {
    const stored = localStorage.getItem(BOOKMARKS_STORAGE_KEY);
    const result = parseStoredBookmarks(stored);
    bookmarks = result.bookmarks;
    if (result.hadInvalidData) {
      showStatus('Some saved data was invalid and has been skipped.', true);
    }
  } catch {
    showStatus('Browser storage is unavailable. Bookmarks cannot be restored or saved.', true);
  }

  renderBookmarks();
</script>
