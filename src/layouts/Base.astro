---
const { title = "Mona's Bookmark Manager App" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      /* Monaspace webfonts (GitHub Next, SIL OFL 1.1) self-hosted from /public/fonts.
         Neon carries body text; Xenon gives headings a touch of contrast.
         Self-hosting keeps the app fully offline-capable — no runtime CDN needed;
         the ui-monospace fallback still covers any load failure. */
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-400.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-700.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-700.woff2') format('woff2');
      }
      :root {
        color-scheme: light;
        --accent: #a63d66;
        --accent-dark: #702547;
        --border: #793d5430;
        --muted: #6d5961;
        --surface: #fffaf7;
        --radius: 0.8rem;
        --font-body: 'Monaspace Neon', ui-monospace, 'SF Mono', 'Cascadia Code', monospace;
        --font-head: 'Monaspace Xenon', 'Monaspace Neon', ui-monospace, monospace;
      }
      * { box-sizing: border-box; }
      body {
        font-family: var(--font-body);
        line-height: 1.5;
        max-width: 46rem;
        margin: 0 auto;
        padding: 3rem 1.25rem 4rem;
        color: #38252d;
        background:
          radial-gradient(ellipse at 10% 0%, #f8e5eb 0, transparent 38rem),
          linear-gradient(160deg, #fffaf7 0%, #fff 62%);
      }
      header { margin-bottom: 1.75rem; }
      h1 { margin: 0 0 0.35rem; font-size: clamp(1.5rem, 5vw, 2rem); font-family: var(--font-head); letter-spacing: -0.02em; }
      .tagline { margin: 0; color: var(--muted); }

      form {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: end;
        margin: 1.5rem 0 0.25rem;
      }
      .field { display: flex; flex-direction: column; gap: 0.35rem; flex: 1 1 16rem; }
      label { font-size: 0.85rem; font-weight: 600; }
      input {
        padding: 0.6rem 0.7rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        font: inherit;
        background: transparent;
        color: inherit;
        transition: border-color 120ms ease, box-shadow 120ms ease;
      }
      input:focus-visible,
      button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px #a63d6620; }
      input[aria-invalid="true"] { border-color: #b42318; }
      button {
        padding: 0.6rem 1rem;
        border: 1px solid transparent;
        border-radius: var(--radius);
        background: var(--accent);
        color: #fff;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }
      button:hover { background: var(--accent-dark); }
      .hint { margin: 0 0 1.5rem; font-size: 0.8rem; color: var(--muted); }
      .feedback { min-height: 1.5rem; margin: 0.2rem 0 0.3rem; font-size: 0.85rem; color: var(--muted); }
      .feedback.error { color: #a52626; }

      #list-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin: 1.5rem 0 0.65rem;
      }
      #list-header[hidden] { display: none; }
      .list-title { margin: 0; font-size: 1rem; font-family: var(--font-head); }
      .clear {
        background: transparent;
        color: inherit;
        border: 1px solid var(--border);
        padding: 0.35rem 0.7rem;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .clear:hover { border-color: currentColor; }

      ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
      li.bookmark {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.4rem 0.55rem;
        padding: 0.75rem 0.9rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: color-mix(in srgb, var(--surface) 92%, white);
        box-shadow: 0 4px 14px #4e25360c;
      }
      .bookmark .url { flex: 1 1 12rem; overflow-wrap: anywhere; color: var(--accent-dark); }
      .bookmark .separator { white-space: pre; color: var(--muted); }
      .bookmark .slug {
        font-family: var(--font-body);
        font-size: 0.85rem;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        background: #f3e1e8;
        color: var(--accent-dark);
      }
      .bookmark .copy {
        background: transparent;
        color: inherit;
        border: 1px solid var(--border);
        padding: 0.3rem 0.6rem;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .bookmark .copy:hover,
      .clear:hover { border-color: var(--accent); color: var(--accent-dark); background: #f9edf1; }
      .empty {
        margin: 0;
        padding: 1.5rem;
        text-align: center;
        color: var(--muted);
        border: 1px dashed var(--border);
        border-radius: var(--radius);
        background: #fffaf780;
      }

      footer { margin-top: 2.5rem; font-size: 0.8rem; color: var(--muted); }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
